PORT=3000
NODE_ENV=development

# Use DATABASE_URL or the DB_* fields below.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sinaltech
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=sinaltech
# DB_USER=postgres
# DB_PASSWORD=postgres
DB_DNS_SERVERS=8.8.8.8,1.1.1.1

# Database TLS mode: auto, disable, require, no-verify.
# no-verify preserves compatibility with hosted Postgres providers that expose
# self-signed/intermediate certificates. Use require when the CA chain is trusted.
DB_SSL_MODE=no-verify

JWT_SECRET=change-this-local-secret
JWT_EXPIRES_IN=12h
SIMULATION_TOKEN_TTL=30m


PASSWORD_MIN_LENGTH=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=8
LOGIN_RATE_LIMIT_BLOCK_MS=1200000

MONITOR_INTERVAL_MS=300000
DAILY_BACKUP_INTERVAL_MS=86400000
AUDIT_LOG_RETENTION_DAYS=180
HTTP_METRICS_MAX_EVENTS=20000
HTTP_METRICS_MAX_AGE_MS=86400000

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=audio-tracks
AUDIO_UPLOAD_MAX_BYTES=3145728
AUDIO_STORAGE_SOFT_LIMIT_BYTES=800000000
